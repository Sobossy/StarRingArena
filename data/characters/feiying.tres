[resource]
script = ExtResource("1")
id = "feiying"
display_name = "绯英"
description = "全场共享一片吐司，拾取回复125生命并化身大运。蓄力1.5秒后朝敌人方向直线冲刺，命中造成150伤害并击飞，继续冲到墙壁才恢复常态；冲刺结束1秒后随机刷新吐司。目标腾空无碰撞、不能自主移动但仍可攻击，落地受到75伤害。常态满5秒后主动寻找吐司。"
portrait = ExtResource("2")
normal_image_path = "res://assets/stickers/039_绯英 好累.png"
portrait_size = 96.0
theme_color = Color(1, 0.65882355, 0.7882353, 1)
