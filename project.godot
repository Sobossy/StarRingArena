; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="星环竞技场"
config/version="0.6.0"
config/description="可扩展的 2D 自动对战竞技场"
run/main_scene="res://main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="StarRingArena"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"

[debug]

gdscript/warnings/inference_on_variant=0

[display]

window/size/viewport_width=1360
window/size/viewport_height=900
window/size/window_width_override=1360
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/size/min_width=1020
window/size/min_height=675
window/handheld/orientation=5

[input_devices]

pointing/emulate_mouse_from_touch=true

[gui]

theme/default_font_multichannel_signed_distance_field=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.024, 0.039, 0.067, 1)
